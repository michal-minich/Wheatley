{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wheatley",
  "version": "0.1.0",
  "identifier": "dev.wheatley.client",
  "build": {
    "beforeDevCommand": "npm run native:client:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run native:client:build",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Wheatley",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:8765 ws://127.0.0.1:8765 http://*.local:8765 ws://*.local:8765",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: http://127.0.0.1:8765 http://*.local:8765",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
