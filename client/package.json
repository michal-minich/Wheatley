{
  "name": "wheatley-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run lint && npm run build",
    "dev": "vite",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "native:client:dev": "VITE_WHEATLEY_API_BASE=${WHEATLEY_NATIVE_API_BASE:?Set WHEATLEY_NATIVE_API_BASE} WHEATLEY_BUILD_TARGET=native vite",
    "native:client:build": "VITE_WHEATLEY_API_BASE=${WHEATLEY_NATIVE_API_BASE:?Set WHEATLEY_NATIVE_API_BASE} WHEATLEY_BUILD_TARGET=native tsc --noEmit && VITE_WHEATLEY_API_BASE=${WHEATLEY_NATIVE_API_BASE:?Set WHEATLEY_NATIVE_API_BASE} WHEATLEY_BUILD_TARGET=native vite build",
    "native:mac:build": "tauri build --bundles app --config src-tauri/tauri.macos.conf.json",
    "native:ios:init": "tauri ios init --ci --config src-tauri/tauri.ios.conf.json",
    "native:ios:dev": "tauri ios dev --config src-tauri/tauri.ios.conf.json",
    "native:ios:build:simulator": "tauri ios build --target aarch64-sim --config src-tauri/tauri.ios.conf.json",
    "native:ios:build:device:unsigned": "tauri ios build --target aarch64 --no-sign --archive-only --ci --config src-tauri/tauri.ios.conf.json",
    "native:ios:build:device": "tauri ios build --target aarch64 --config src-tauri/tauri.ios.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "markdown-it": "^14.3.0"
  }
}
