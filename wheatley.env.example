# Copy this file to wheatley.local.env for machine-specific paths.
# The local file is ignored by Git.

# WHEATLEY_HOME="$HOME/.wheatley"
# WHEATLEY_APP_DATA_ROOT="$HOME/.local/share/wheatley"
# Resources always live at $WHEATLEY_APP_DATA_ROOT/resources.
# WHEATLEY_CONFIG_PATH="$WHEATLEY_HOME/config.json"
# WHEATLEY_PROFILES_ROOT="$WHEATLEY_HOME/Profiles"
# Setup creates a private token at this path for the remote image worker.
# WHEATLEY_IMAGE_TOKEN_PATH="$WHEATLEY_HOME/image-generation-token"
# Required only by scripts/server/hybrid.sh.
# WHEATLEY_SYNC_UPSTREAM_API_BASE="http://server.local:8765/api"
# Reserved for explicit remote Conversation placement; the adapter currently
# fails startup until profile/session and accepted-artifact handoff are complete.
# WHEATLEY_CONVERSATION_REMOTE_API_BASE="http://server.local:8765/api"

# Bootstrap installs a private D toolchain here when dub is not already on PATH.
# WHEATLEY_DLANG_ROOT="$WHEATLEY_APP_DATA_ROOT/toolchains/dlang"
# WHEATLEY_D_COMPILER="ldc-1.42.0" # Windows default: dmd-2.112.0

# Override only to deliberately test another Pi release.
# WHEATLEY_PI_NPM_SPEC="@earendil-works/pi-coding-agent@0.83.0"

# Codex delegation is disabled unless its workspace is configured.
# WHEATLEY_CODEX_WORKSPACE_ROOT="/path/to/a/trusted/workspace"
# WHEATLEY_CODEX_SOCKET="$WHEATLEY_APP_DATA_ROOT/wheatley-codexd.sock"

# LAN mode is unauthenticated. Enable only on a trusted network.
# WHEATLEY_TRUSTED_LAN=yes
